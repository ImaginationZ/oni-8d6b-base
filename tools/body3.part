</div>

<script>
(function(){
  var g=document.getElementById('sched'); var out='<div></div>';
  for(var h=0;h<24;h++) out+='<div class="h">'+h+'</div>';
  [['Dupes shift 1',15],['Dupes shift 2',10],['Dupes shift 3',5],['Dupes shift 4',0]].forEach(function(r){
    out+='<div class="who">'+r[0]+' (2)</div>';
    for(var h=0;h<24;h++){var d=(h-r[1]+24)%24;var k=d<4?'S':(d<8?'D':'W');
      out+='<div class="c '+k+'" title="'+r[0]+' · hour '+h+'"></div>';}
  });
  for(var p=1;p<=3;p++){
    out+='<div class="who">Bionics pair '+p+' · cycle '+p+'/3</div>';
    for(var h=0;h<24;h++) out+='<div class="c '+(h<6?'D':'W')+'" title="Bionic pair '+p+', cycle '+p+' of 3 · hour '+h+'"></div>';
  }
  g.innerHTML=out;
  var b=document.getElementById('copy'), t=document.getElementById('bni');
  b.addEventListener('click',function(){
    var done=function(){document.getElementById('copied').hidden=false;document.getElementById('sel').hidden=true;};
    var fail=function(){t.focus();t.select();document.getElementById('sel').hidden=false;};
    try{navigator.clipboard.writeText(t.value).then(done,fail);}catch(e){fail();}
  });
})();
</script>
