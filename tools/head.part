<title>Twin-Spine 8+6 Base</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* Layout: a drafting sheet. One wide to-scale drawing up top, then narrow reading columns of spec tables. */
:root{
  --bg:#eef3f4; --sheet:#f8fbfb; --fg:#172326; --muted:#55686c; --line:#c9d6d8; --grid:#dbe5e7;
  --accent:#0f7c86; --accent-ink:#ffffff; --warn:#a4570c;
  --tile:#8d9a9c; --ins:#5a5446; --door:#c77a1a; --pdoor:#b0451f; --pole:#7a4b1c; --ladder:#3d6b8c; --tube:#7d58a8;
  --b:#ffffff; --b-stroke:#4c5d61; --b-deco:#f3e9d2; --b-bed:#dfe6fb; --b-suit:#e9e4f6; --b-key:#ffd7a3;
  --r-sleep:#c8d3f7; --r-bion:#bfe6e1; --r-wash:#c3e6f2; --r-rec:#f6e1b5; --r-park:#cfe8c0; --r-suit:#e2dcef;
  --r-kit:#f6d2b7; --r-ban:#f3c9d0; --r-bsvc:#b9ddd6; --r-pow:#efe6a6; --r-life:#cde0ee; --r-work:#dcdcd6; --r-steam:#f2c3b8; --r-shaft:#e6ecec;
  --s-work:#9fb4b8; --s-down:#f1c46b; --s-bath:#7cc3d9; --s-bed:#6f7fcf;
  --display:"Chakra Petch", "Segoe UI", system-ui, sans-serif;
  --body:"IBM Plex Sans", system-ui, -apple-system, sans-serif;
  --mono:"IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){
  --bg:#0f1719; --sheet:#152024; --fg:#e3eced; --muted:#93a7ab; --line:#2a3a3e; --grid:#1d2b2f;
  --accent:#4fc3cc; --accent-ink:#06282b; --warn:#f0a35a;
  --tile:#5d6b6e; --ins:#8c8265; --door:#e09a3c; --pdoor:#e3683d; --pole:#d19a5d; --ladder:#7fb2d6; --tube:#b394dc;
  --b:#1f2e33; --b-stroke:#9db1b5; --b-deco:#3a3424; --b-bed:#27325a; --b-suit:#352d4d; --b-key:#6b4614;
  --r-sleep:#232c4f; --r-bion:#1c3d3a; --r-wash:#1b3b48; --r-rec:#43381c; --r-park:#243d1f; --r-suit:#2f2a40;
  --r-kit:#47301f; --r-ban:#472630; --r-bsvc:#1a3a35; --r-pow:#3e3a17; --r-life:#1f3242; --r-work:#2c2e2b; --r-steam:#4a2721; --r-shaft:#1a2427;
  --s-work:#4f6468; --s-down:#b98a2c; --s-bath:#3a8aa3; --s-bed:#4553a3; color-scheme:dark }}
:root[data-theme="dark"]{
  --bg:#0f1719; --sheet:#152024; --fg:#e3eced; --muted:#93a7ab; --line:#2a3a3e; --grid:#1d2b2f;
  --accent:#4fc3cc; --accent-ink:#06282b; --warn:#f0a35a;
  --tile:#5d6b6e; --ins:#8c8265; --door:#e09a3c; --pdoor:#e3683d; --pole:#d19a5d; --ladder:#7fb2d6; --tube:#b394dc;
  --b:#1f2e33; --b-stroke:#9db1b5; --b-deco:#3a3424; --b-bed:#27325a; --b-suit:#352d4d; --b-key:#6b4614;
  --r-sleep:#232c4f; --r-bion:#1c3d3a; --r-wash:#1b3b48; --r-rec:#43381c; --r-park:#243d1f; --r-suit:#2f2a40;
  --r-kit:#47301f; --r-ban:#472630; --r-bsvc:#1a3a35; --r-pow:#3e3a17; --r-life:#1f3242; --r-work:#2c2e2b; --r-steam:#4a2721; --r-shaft:#1a2427;
  --s-work:#4f6468; --s-down:#b98a2c; --s-bath:#3a8aa3; --s-bed:#4553a3; color-scheme:dark }
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font-family:var(--body);font-size:15px;line-height:1.55}
.wrap{max-width:1080px;margin:0 auto;padding-block:28px 64px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:grid;gap:36px}
h1,h2,h3{font-family:var(--display);text-wrap:balance;margin:0;letter-spacing:.01em}
h1{font-size:clamp(28px,4.4vw,44px);line-height:1.05}
h2{font-size:22px;margin-bottom:10px}
h3{font-size:16px;margin-bottom:6px}
p{margin:0;max-width:68ch}
.eyebrow{font-family:var(--mono);font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:var(--accent)}
header{display:grid;gap:12px}
.lede{color:var(--muted);font-size:16px}
.specs{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}
.spec{font-family:var(--mono);font-size:12.5px;border:1px solid var(--line);background:var(--sheet);padding:4px 9px;border-radius:3px}
.spec b{color:var(--accent);font-weight:500}
.sheet{background:var(--sheet);border:1px solid var(--line);border-radius:4px;padding:14px}
.draw{overflow-x:auto;-webkit-overflow-scrolling:touch}
.draw svg{display:block;max-width:none;height:auto}
.grid{stroke:var(--grid);stroke-width:1}
.tile{fill:var(--tile)} .ins{fill:var(--ins)}
.door{fill:var(--door)} .pdoor{fill:var(--pdoor)}
.pole{stroke:var(--pole);stroke-width:2.2}
.ladder line{stroke:var(--ladder);stroke-width:1.3}
.tube{fill:var(--tube);opacity:.8}
.b{fill:var(--b);stroke:var(--b-stroke);stroke-width:1}
.b-deco{fill:var(--b-deco);stroke:var(--b-stroke);stroke-width:.8}
.b-bed{fill:var(--b-bed);stroke:var(--b-stroke);stroke-width:1}
.b-suit{fill:var(--b-suit);stroke:var(--b-stroke);stroke-width:1}
.b-key{fill:var(--b-key);stroke:var(--warn);stroke-width:1.6}
.lbl{fill:var(--fg);font-family:var(--mono);text-anchor:middle;dominant-baseline:central;pointer-events:none}
.rlab{fill:var(--muted);font-family:var(--display);font-size:9.5px;font-weight:600;letter-spacing:.03em}
.axis{fill:var(--accent);font-family:var(--display);font-size:12px;font-weight:700}
.note{fill:var(--muted);font-family:var(--mono);font-size:10px}
.r-sleep{fill:var(--r-sleep)} .r-bion{fill:var(--r-bion)} .r-wash{fill:var(--r-wash)} .r-rec{fill:var(--r-rec)} .r-park{fill:var(--r-park)}
.r-suit{fill:var(--r-suit)} .r-kit{fill:var(--r-kit)} .r-ban{fill:var(--r-ban)} .r-bsvc{fill:var(--r-bsvc)} .r-pow{fill:var(--r-pow)}
.r-life{fill:var(--r-life)} .r-work{fill:var(--r-work)} .r-steam{fill:var(--r-steam)} .r-shaft{fill:var(--r-shaft)}
.legend{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:10px;font-size:12.5px;color:var(--muted)}
.legend span{display:inline-flex;align-items:center;gap:6px}
.sw{width:12px;height:12px;border-radius:2px;display:inline-block;border:1px solid var(--line)}
.caption{font-size:13px;color:var(--muted);margin-top:8px}
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px}
.cols>*{min-width:0}
.tbl{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:14px}
th,td{text-align:left;padding:7px 10px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-family:var(--mono);font-size:11.5px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-weight:500}
td.n{font-family:var(--mono);font-variant-numeric:tabular-nums;white-space:nowrap}
td.f{font-family:var(--display);font-weight:700;color:var(--accent);white-space:nowrap}
.sched{display:grid;grid-template-columns:118px repeat(24,minmax(14px,1fr));gap:2px;font-family:var(--mono);font-size:11px;min-width:560px}
.sched .h{color:var(--muted);text-align:center}
.sched .who{font-family:var(--body);font-size:12.5px;padding-right:6px;white-space:nowrap}
.c{height:22px;border-radius:2px;display:flex;align-items:center;justify-content:center;font-size:10px;color:var(--fg)}
.c.W{background:var(--s-work)} .c.D{background:var(--s-down)} .c.B{background:var(--s-bath)} .c.S{background:var(--s-bed);color:#fff}
.c.eat{outline:2px solid var(--warn);outline-offset:-2px;font-weight:600}
ul{margin:0;padding-left:20px;display:grid;gap:5px;max-width:72ch}
.pill{font-family:var(--mono);font-size:11px;padding:1px 7px;border-radius:999px;border:1px solid var(--line);color:var(--muted);white-space:nowrap}
.check{border-left:3px solid var(--warn);padding:10px 14px;background:var(--sheet)}
textarea{width:100%;height:180px;font-family:var(--mono);font-size:11.5px;background:var(--bg);color:var(--fg);border:1px solid var(--line);border-radius:3px;padding:8px;resize:vertical}
button{font-family:var(--display);font-weight:600;font-size:14px;background:var(--accent);color:var(--accent-ink);border:0;border-radius:3px;padding:8px 14px;cursor:pointer}
button:focus-visible,textarea:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.row{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:8px}
a{color:var(--accent)}
code{font-family:var(--mono);font-size:.92em}
</style>

